/*
shell function to run the process based on primitive and year
*/
function runModel(primitive, year, sampledPoints){
  
  /*
  get the composite to classify, add covariates to it and then select the only ones that are
  important to the classification. This comes from testing the random forest classifier using R
  */
  var composite = ee.Image(repository+'/'+year);
  var covImage = addCovariates.addCovariatesToImage(composite)
              // .select(importantFeatures[primitive]);
  // print(composite,covImage)
  
  /*
  initiate the classification process
  */
  var classifiedImage = classifyImage(covImage, sampledPoints, boundary);
  
  /*
  mask the classified image to remove pixels that were classified with filled information
  */
  classifiedImage = classifiedImage.updateMask(composite.select('B4').mask());
  return classifiedImage;
  /*
  add classified layer to map and export it - commented to make stack
  */
  /*Map.addLayer(classifiedImage, {}, year+" - " + primitive, false);
  exportHelper(classifiedImage, primitive, year);*/
}

/*
main function takes images with covariates and sampled points
returns an array with classified image and confusion matrix
*/
function classifyImage(covImage, sampledPoints, boundary){
  var bandNames = covImage.bandNames().remove(landClassField);
  
  var classifier = ee.Classifier.smileRandomForest(numberOfTrees)
    .setOutputMode('PROBABILITY')
    .train({
      features : sampledPoints,
      classProperty: landClassField,
      inputProperties: bandNames
    });
    
   
  var classifiedImage = covImage.classify(classifier);
  
  return classifiedImage;
}

/*
function to help export
*/
function exportHelper(image, primitive, year){
  Export.image.toAsset({
    'image':image.multiply(10000).toUint16(),
    'description':'Export-'+primitive+'-'+year,
    'assetId': exportColl+'/'+primitive+'-'+year,
    'region': boundary.bounds(),
    'scale': exportScale,
    'maxPixels':1e13
  })
}

/*
function to remap class points to 1
*/
function remapClassPoints(feature){
  return feature.set(landClassField,1);
}

/*
function to remap non class points to 0
*/
function remapOtherPoints(feature){
  return feature.set(landClassField,0);
}


