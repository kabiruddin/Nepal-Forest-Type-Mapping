function applyMinMapUnits(image){
  var minimumMappingUnit = 5000;
  var scale = 10;
  var pixels = parseInt(minimumMappingUnit/(scale*scale));
  var chainCount = image.connectedPixelCount(pixels+2,true).reproject({crs:'EPSG:4326',scale:10});
  var removePixels = chainCount.lt(pixels).reproject({crs:'EPSG:4326',scale:10});
  var median = image.focal_mode().updateMask(removePixels).reproject({crs:'EPSG:4326',scale:10});
  var final = median.unmask(image).reproject({crs:'EPSG:4326',scale:10});
  return final.updateMask(image);
}



